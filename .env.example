# BidCore 环境配置示例（复制为 .env 后填写；.env 不会被提交）
# 模型网关：OpenCode（OpenAI 兼容）。POST /chat/completions 必须带非空 x-opencode-session。
# 不填 LLM_API_KEY → 自动降级为确定性 Mock 写作器，全链路仍可演示（断网可用）。
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_SESSION_ID=bidcore
LLM_MODE=openai
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_MS=90000
LLM_JUDGE_MODEL=

# 服务
PORT=5192
HOST=127.0.0.1
BIDCORE_LOG=0

# 令牌签名密钥：不设置则用内置演示值。对外开放前务必改成随机长串，
# 例如：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BIDCORE_SECRET=

# 数据库路径：留空 = var/bidcore.db；多实例/测试可指向独立文件
BIDCORE_DB=
