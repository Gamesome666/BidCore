# 统一换行：仓库内一律 LF，避免 Windows / Linux 混提产生整文件 diff
* text=auto eol=lf

*.mjs   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制：不做换行转换，也不尝试文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff2 binary
*.docx  binary
*.db    binary
*.zip   binary

# 文档与截图在 GitHub 上折叠显示
docs/shots/*.png linguist-documentation
