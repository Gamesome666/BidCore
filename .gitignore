# ── 运行时数据（SQLite 库 / WAL / 导出文件 / 调试截图）
var/*
!var/.gitkeep
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.docx
!docs/**/*.docx

# ── 本地配置与密钥（示例文件除外）
.env
.env.*
!.env.example
*.pem
*.key

# ── 依赖与构建（本项目零依赖，仅防御性忽略）
node_modules/
dist/
build/
coverage/
.pnpm-store/

# ── 日志与临时产物
*.log
npm-debug.log*
yarn-error.log*
*.tmp
*.bak
*.orig
*.rej

# ── 演示录制工作区（只保留 storyboard / 脚本；成品在 docs/video）
/demo/.chrome-profile*/
/demo/recordings/
/demo/frames/
/demo/final-frames/
/demo/output/
/demo/audio/
/demo/logs/
/demo/srv.*
/demo/tts.*

# ── 演示视频成品（体积大，不入库；需要时挂 Release Assets 后从 README 外链）
/docs/video/

# ── 编辑器 / 操作系统
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
